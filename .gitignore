# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Node (only used for the optional local preview server)
node_modules/

# Operating system and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Staging and scratch. Master transactions stage outside the repository and enter only through the runner.
/stage/
/scratch/
*.tmp

# Packaged checkpoints are built from `checkpoint/*` tags by CI, never committed (no nested ZIPs).
*.zip

# Claude Design's reference implementation builds into design/reference/out/ (regenerated by its documented command;
# tested with YFIE_SITE_DIR=design/reference/out). The source under design/reference/ is committed; its output is not.
/design/reference/out/

# D1 canvas exploration renders (twins, screenshots, artboards) are regenerated by design/exploration/d1_canvas/build_boards.py.
/design/exploration/d1_canvas/out/

# Generated data exports (scripts/exports.py; a CI artefact, published only by the public_downloads switch)
/build/
