# Host headers for the static site (Part B B14 b; REL-01; the contract is docs/DEPLOYMENT.md, "Security and privacy").
# The release host is DigitalOcean (owner decision of 3 October 2026): scripts/hosting_nginx.py writes this file, as
# relocated under the base path by scripts/build.py --out, into the nginx server block the App Platform service runs,
# proved in a real nginx by scripts/tests/test_digitalocean_hosting.py. Cloudflare Pages and Netlify read the file as
# it is; GitHub Pages cannot set headers (docs/DEPLOYMENT.md). Only a trailing '/*' pattern is supported.
# Source: site-src/hosting/_headers, copied unchanged into dist/ by scripts/build.py; checked by
# scripts/tests/test_security_headers.py, which serves dist/ with these headers and loads every page.
# Path rules never overlap, so no host ever joins two values of one header.
#
# Strict-Transport-Security is switched off until HTTPS is confirmed on the release domain (docs/RELEASE_RUNBOOK.md,
# step "Headers"): then add, under "/*",  Strict-Transport-Security: max-age=31536000; includeSubDomains

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  X-Frame-Options: DENY

# HTML and the search data: short, revalidated, so a corrected record reaches readers within minutes
/
  Cache-Control: public, max-age=300, must-revalidate
/index.html
  Cache-Control: public, max-age=300, must-revalidate
/404.html
  Cache-Control: public, max-age=300, must-revalidate
/en/*
  Cache-Control: public, max-age=300, must-revalidate
/ar/*
  Cache-Control: public, max-age=300, must-revalidate
/static-data/*
  Cache-Control: public, max-age=300, must-revalidate
/robots.txt
  Cache-Control: public, max-age=3600
/sitemap.xml
  Cache-Control: public, max-age=3600

# Assets: names are not fingerprinted (TOOL-02), so an hour; the canonical fonts never change, so thirty days
/assets/app.js
  Cache-Control: public, max-age=3600
/assets/lang-redirect.js
  Cache-Control: public, max-age=3600
/assets/yfie.css
  Cache-Control: public, max-age=3600
/assets/logo/*
  Cache-Control: public, max-age=3600
/assets/social/*
  Cache-Control: public, max-age=3600
/assets/fonts/*
  Cache-Control: public, max-age=2592000
